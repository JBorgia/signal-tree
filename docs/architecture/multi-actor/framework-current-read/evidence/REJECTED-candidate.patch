+    expect(callbacks).toEqual([
+      {
+        activeId: 'A',
+        ids: ['A', 'C'],
+        all: [
+          { id: 'A', n: 1 },
+          { id: 'C', n: 3 },
+        ],
+        directA: 1,
+      },
+    ]);
+    expect(final).toEqual({
+      activeId: 'C',
+      ids: ['A', 'C'],
+      all: [
+        { id: 'A', n: 1 },
+        { id: 'C', n: 3 },
+      ],
+      directA: 1,
