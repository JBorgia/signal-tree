+import type {ClaimedFieldEndpoint,NativeFieldEndpoint} from './native-field-selection';
+export interface SelectedRowEdit {
+ readonly source:object; readonly subject:number; readonly key:string|number;
+ readonly before:unknown; readonly after:unknown; readonly fields:readonly string[];
+ readonly selections:ReadonlyMap<string,NativeFieldEndpoint>;
+ readonly prepare:(edits:readonly SelectedRowEdit[])=>SelectedInstallation;
+}
+export interface SelectedInstallation {install():void;invalidate():void;publish():void}
+export interface SelectedPreparation {
+ stage(edit:SelectedRowEdit):void;
+ defer(delivery:()=>void):void;
+}
+export interface SelectedInvocation {
+ phase:'open'|'consumed'|'closed';
+ failed?:boolean;failure?:unknown;
+ request?:{value:unknown;selection:ClaimedFieldEndpoint};
+}
+export function openSelected(value:unknown,selection:ClaimedFieldEndpoint):SelectedInvocation{return {phase:'open',request:{value,selection}};}
+export function closeSelected(invocation:SelectedInvocation):void{invocation.phase='closed';invocation.request=undefined;invocation.failure=undefined;}
+export function failSelected(invocation:SelectedInvocation,error:unknown):void{if(!invocation.failed){invocation.failed=true;invocation.failure=error;}invocation.phase='closed';invocation.request=undefined;}
+export function consumeSelected(invocation:SelectedInvocation):{value:unknown;selection:ClaimedFieldEndpoint}{
+ if(invocation.phase!=='open'||!invocation.request)throw new Error('Selected continuation is closed or consumed');
+ const request=invocation.request;invocation.phase='consumed';invocation.request=undefined;return request;
+}
+/** Closure has no separate value, selection, target or operation reference. */
+export function selectedProceed(invocation:SelectedInvocation,next:(invocation:SelectedInvocation)=>void):()=>void{
+ let forwarded=false;
+ return ()=>{if(forwarded||invocation.phase!=='open')throw new Error('Selected continuation cannot replay');forwarded=true;try{next(invocation);}catch(error){failSelected(invocation,error);throw error;}};
+}
