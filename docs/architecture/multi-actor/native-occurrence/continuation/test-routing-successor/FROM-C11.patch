+#!/usr/bin/env node
+import { createHash } from 'node:crypto';
+import { mkdirSync, mkdtempSync, readFileSync, readdirSync, writeFileSync } from 'node:fs';
+import { join, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+
+const ROOT = fileURLToPath(new URL('../', import.meta.url));
+if (process.argv.length !== 2) throw new Error('The forwarding retention gate requires all nine modes; no filters are accepted.');
+const base = join(ROOT, 'artifacts/forwarding-retention');
+mkdirSync(base, { recursive: true });
+const output = mkdtempSync(join(base, 'run-'));
+const save = (name, value) => writeFileSync(join(output, name), JSON.stringify(value, null, 2) + '\n');
+const sourceHashes = {};
+function hashFile(file) {
+  sourceHashes[relative(ROOT, file)] = createHash('sha256').update(readFileSync(file)).digest('hex');
+}
+function hashRuntime(dir) {
+  for (const entry of readdirSync(dir, { withFileTypes: true })) {
+    const file = join(dir, entry.name);
+    if (entry.isDirectory()) hashRuntime(file);
+    else if (entry.name.endsWith('.ts') && !/\.(spec|test)\.ts$/.test(entry.name)) hashFile(file);
+  }
+}
+hashRuntime(join(ROOT, 'packages/kernel/src'));
+for (const name of ['tools/check-forwarding-retention.mjs', 'tools/lib/heap-quiescence.mjs', 'packages/kernel/src/lib/forwarding-retention-probe.spec.ts', 'packages/kernel/vitest.retention.config.ts', '.nvmrc', 'package.json', 'pnpm-lock.yaml']) hashFile(join(ROOT, name));
+save('SOURCE.json', sourceHashes);
+console.log(`Forwarding retention artifacts: ${output}`);
+const results = [];
+for (const arm of ['hold-proceed', 'drop-proceed', 'hold-value']) {
+  for (const scenario of ['success', 'skip', 'caught']) {
+    const name = `${arm}-${scenario}`;
+    const artifact = join(output, `${name}.json`);
+    const env = { NODE_OPTIONS: '--expose-gc', ST_GC_ARM: arm, ST_GC_SCENARIO: scenario, ST_GC_OUTPUT: artifact };
+    const argv = [join(ROOT, 'node_modules/vitest/vitest.mjs'), 'run', '--root', 'packages/kernel', '--config', 'vitest.retention.config.ts', 'src/lib/forwarding-retention-probe.spec.ts', '--maxWorkers=1'];
+    save(`${name}-COMMAND.json`, { executable: process.execPath, argv, cwd: ROOT, node: process.version, env });
+    const run = spawnSync(process.execPath, argv, { cwd: ROOT, env: { ...process.env, ...env }, encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
+    const raw = `${run.stdout ?? ''}${run.stderr ?? ''}`;
+    writeFileSync(join(output, `${name}.log`), raw);
+    const errors = [];
+    if (run.error || run.signal || run.status !== 0) errors.push(run.error?.message ?? `child exit=${run.status} signal=${run.signal}`);
+    try {
+      const sample = JSON.parse(readFileSync(artifact, 'utf8'));
+      if (sample.arm !== arm || sample.scenario !== scenario || sample.node !== process.version ||
+          !Array.isArray(sample.held) || sample.held.length !== 12 ||
+          !Array.isArray(sample.released) || sample.released.length !== 12)
+        errors.push('Missing, mismatched or incomplete original sampling artifact');
+    } catch (error) { errors.push(`Sampling output: ${error.message}`); }
+    results.push({ arm, scenario, exit: errors.length ? 1 : 0, errors, artifact, log: join(output, `${name}.log`) });
+    console.log(`${name}: ${errors.length ? 'FAIL' : 'PASS'}`);
+    if (errors.length) process.stdout.write(raw);
+  }
+}
+const failed = results.length !== 9 || results.some(result => result.exit !== 0);
+save('RESULT.json', { exit: failed ? 1 : 0, requiredModes: 9, executedModes: results.length, results, scope: 'Original nine-mode forwarding collectibility fixtures, not universal reclamation or heap cost.' });
+console.log(`Forwarding retention: ${results.filter(result => !result.exit).length}/9 passed`);
+process.exitCode = failed ? 1 : 0;
