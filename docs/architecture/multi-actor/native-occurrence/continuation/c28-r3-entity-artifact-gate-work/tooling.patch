+    replay(clean, 'recovery');
+  }
+  report.passed = true;
+} catch (error) {
+  report.passed = false;
+  report.error = error.stack;
+  process.exitCode = 1;
+} finally {
+  if (before) {
+    try {
+      assert.equal(
+        buildIntegrity(ROOT, packages),
+        before.integrity,
+        'canonical artifacts changed'
+      );
+      assert.deepEqual(inputHashes(), before.inputs, 'gate inputs changed');
+      report.inputsUnchanged = true;
