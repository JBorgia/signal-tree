+}
+
+let before;
+let packages;
+const inputPaths = [
+  ...fixtureFiles,
+  `${PROBES}/build-consumers.mjs`,
+  `${PEERS}/package.json`,
+  `${PEERS}/package-lock.json`,
+  'tools/verify-entity-registration-artifacts.mjs',
+  'tools/verify-gates.mjs',
+  'pnpm-lock.yaml',
+  'package.json',
+  '.nvmrc',
