+  report.node = process.version;
+  report.npm = command('npm-version', ['npm', '--version'], ROOT).stdout.trim();
+  command(
+    'verify-artifacts',
+    [
+      process.execPath,
+      'scripts/prepare-publish-artifacts.mjs',
+      '--verify-only',
+    ],
+    ROOT
