{
  "apps/demo-e2e/project.json": {
    "name": "demo-e2e",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/demo-e2e/src",
    "implicitDependencies": [
      "demo"
    ],
    "// targets": "to see all targets run: nx show project demo-e2e --web",
    "targets": {}
  },
  "apps/demo/project.json": {
    "name": "demo",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/demo/src",
    "tags": [],
    "targets": {
      "build": {
        "executor": "@angular/build:application",
        "outputs": [
          "{options.outputPath}"
        ],
        "dependsOn": [
          "generate-versions",
          "generate-deep-typing-proofs"
        ],
        "defaultConfiguration": "production",
        "options": {
          "outputPath": "dist/apps/demo",
          "browser": "apps/demo/src/main.ts",
          "tsConfig": "apps/demo/tsconfig.app.json",
          "inlineStyleLanguage": "scss",
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/demo/public"
            },
            {
              "glob": "README.md",
              "input": "packages/kernel",
              "output": "assets/docs/core"
            },
            {
              "glob": "README.md",
              "input": "packages/angular",
              "output": "assets/docs/angular"
            },
            {
              "glob": "README.md",
              "input": "packages/react",
              "output": "assets/docs/react"
            },
            {
              "glob": "README.md",
              "input": "packages/vue",
              "output": "assets/docs/vue"
            },
            {
              "glob": "README.md",
              "input": "packages/solid",
              "output": "assets/docs/solid"
            },
            {
              "glob": "composition-recipes.md",
              "input": "docs/guides",
              "output": "assets/docs/guides"
            },
            {
              "glob": "persistence-guide.md",
              "input": "docs/guides",
              "output": "assets/docs/guides"
            }
          ],
          "styles": [
            "apps/demo/src/styles.scss"
          ]
        },
        "configurations": {
          "production": {
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "525kb",
                "maximumError": "570kb"
              },
              {
                "type": "anyComponentStyle",
                "maximumWarning": "50kb",
                "maximumError": "100kb"
              }
            ],
            "outputHashing": "all",
            "optimization": {
              "scripts": true,
              "styles": true,
              "fonts": true
            },
            "aot": true,
            "namedChunks": false
          },
          "development": {
            "optimization": false,
            "extractLicenses": false,
            "sourceMap": true
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@angular/build:dev-server",
        "defaultConfiguration": "development",
        "configurations": {
          "production": {
            "buildTarget": "demo:build:production"
          },
          "development": {
            "buildTarget": "demo:build:development"
          }
        }
      },
      "extract-i18n": {
        "executor": "@angular/build:extract-i18n",
        "options": {
          "buildTarget": "demo:build"
        }
      },
      "lint": {
        "executor": "@nx/eslint:lint"
      },
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{workspaceRoot}/coverage/{projectRoot}"
        ],
        "dependsOn": [
          "generate-deep-typing-proofs"
        ],
        "options": {
          "jestConfig": "apps/demo/jest.config.ts",
          "passWithNoTests": true,
          "tsConfig": "apps/demo/tsconfig.spec.json"
        }
      },
      "generate-versions": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/generate-version-env.cjs"
        }
      },
      "generate-deep-typing-proofs": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/generate-deep-typing-proofs.mjs"
        }
      },
      "serve-static": {
        "continuous": true,
        "executor": "@nx/web:file-server",
        "options": {
          "buildTarget": "demo:build",
          "port": 4200,
          "staticFilePath": "dist/apps/demo/browser",
          "spa": true
        }
      }
    }
  },
  "apps/react-reference/project.json": {
    "name": "react-reference",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/react-reference/src",
    "projectType": "application",
    "tags": [],
    "// targets": "to see all targets run: nx show project react-reference --web",
    "targets": {}
  },
  "packages/angular/project.json": {
    "name": "angular",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/angular/src",
    "prefix": "lib",
    "projectType": "library",
    "release": {
      "version": {
        "manifestRootsToUpdate": [
          "dist/{projectRoot}"
        ],
        "currentVersionResolver": "git-tag",
        "fallbackCurrentVersionResolver": "disk"
      }
    },
    "tags": [],
    "implicitDependencies": [],
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/{projectRoot}"
        ],
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "rollup"
            ]
          }
        ]
      },
      "nx-release-publish": {
        "options": {
          "packageRoot": "dist/{projectRoot}"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "NODE_OPTIONS=--expose-gc npx vitest run --root packages/angular",
          "forwardAllArgs": true
        }
      },
      "lint": {
        "executor": "@nx/eslint:lint"
      }
    }
  },
