  "tools/held-continuation-probe/project.json": {
    "name": "held-continuation-probe",
    "root": "tools/held-continuation-probe",
    "targets": {
      "retention": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "corepack pnpm exec vitest run --root packages/kernel --config retention-probe.config.ts",
          "cwd": "."
        }
      },
      "extended": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "corepack pnpm exec vitest run --root packages/kernel --config forwarding-retention.config.ts",
          "cwd": "."
        }
