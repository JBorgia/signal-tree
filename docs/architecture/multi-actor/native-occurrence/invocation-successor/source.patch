+export interface ClaimedFieldEndpoint {readonly source:object;readonly subject:number;readonly field:string;readonly endpoint:NativeFieldEndpoint}
+const INVOCATION=Symbol('native-inverse-invocation');
+type Invocation={claim?:ClaimedFieldEndpoint;claimed:boolean;closed:boolean};
+type InvocationMetadata=WriteMetadata&{[INVOCATION]?:Invocation};
+export function withFieldEndpointInvocation<T>(binding:{source:object;subject?:number},field:string,endpoint:NativeFieldEndpoint,body:()=>T):T {
+  if(binding.subject===undefined)throw new Error('Inverse endpoint has no subject lifetime');
+  const token:Invocation={claim:Object.freeze({source:binding.source,subject:binding.subject,field,endpoint}),claimed:false,closed:false};
+  const meta:InvocationMetadata={...getActiveWriteContext(),[INVOCATION]:token};
+  try{return withWriteContext(meta,body);}finally{token.closed=true;token.claim=undefined;}
+}
+export function claimFieldEndpointInvocation(source:object,subject:number|undefined,fields:readonly string[]|null=null):ClaimedFieldEndpoint|undefined {
+  const token=(getActiveWriteContext() as InvocationMetadata|undefined)?.[INVOCATION];
+  if(!token||token.closed||token.claimed||token.claim?.source!==source||token.claim.subject!==subject||fields!==null&&!fields.includes(token.claim.field))return undefined;
+  token.claimed=true;return token.claim;
+}
