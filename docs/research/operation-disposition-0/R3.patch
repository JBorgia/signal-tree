+/** Replay this bounded ordinary rollback's structural positions in authored order.
+ * Removals before restoration must already be absent; removals afterward cannot
+ * strand a normalized anchor because the restored subject is already placed.
+ * Rekeys do not change subject order. General target normalization stays strict.
+ */
+function deriveSingletonRestoreOrder(
+  sourceOrder: readonly number[], effects: readonly ReversalEffect[]
+): number[] {
+  const order = [...sourceOrder];
+  for (const effect of effects) {
+    if (typeof effect.subjectId !== 'number') continue;
+    if (effect.structural === 'remove') {
+      const index = order.indexOf(effect.subjectId);
+      if (index >= 0) order.splice(index, 1);
+    } else if (effect.structural === 'add') {
+      const context = effect.structuralContext;
+      if (context?.kind !== 'add' && context?.kind !== 'remove') {
+        throw new Error('Singleton restore has no structural context');
+      }
+      const nodes = order.map((subjectId): ActiveNode<number> => ({
+        subjectId, key: subjectId, prev: undefined, next: undefined
+      }));
+      nodes.forEach((node, index) => {
+        node.prev = nodes[index - 1]; node.next = nodes[index + 1];
+      });
+      const bySubject = new Map(nodes.map(node => [node.subjectId, node]));
+      const placement = resolveSingletonRestorePlacement(
+        context.beforeSubject === undefined ? undefined : bySubject.get(context.beforeSubject),
+        context.afterSubject === undefined ? undefined : bySubject.get(context.afterSubject),
+        nodes[nodes.length - 1],
+        (before, after) => order.indexOf(before.subjectId) < order.indexOf(after.subjectId)
+      );
+      const index = placement.afterSubject !== undefined
+        ? order.indexOf(placement.afterSubject)
+        : placement.beforeSubject !== undefined
+        ? order.indexOf(placement.beforeSubject) + 1 : order.length;
+      order.splice(index, 0, effect.subjectId);
+    }
+  }
+  return order;
