+        beforeSubject: beforeNode.subjectId,
+        afterSubject: beforeNode.next?.subjectId,
+        beforeKey: beforeNode.key,
+        afterKey: beforeNode.next?.key,
+      };
+    }
+
+    return {
+      beforeSubject: tail?.subjectId,
+      beforeKey: tail?.key,
+    };
