+/** Shared singleton restore policy. Callers supply the order at installation. */
+export function resolveSingletonRestorePlacement<K extends string | number>(
+  beforeNode: ActiveNode<K> | undefined,
+  afterNode: ActiveNode<K> | undefined,
+  tail: ActiveNode<K> | undefined,
+  precedes: (before: ActiveNode<K>, after: ActiveNode<K>) => boolean
+): ResolvedSubjectRestorePlacement<K> {
+    if (beforeNode !== undefined && afterNode !== undefined) {
+      if (precedes(beforeNode, afterNode)) {
+        return {
+          beforeSubject: beforeNode.subjectId,
+          afterSubject: afterNode.subjectId,
+          beforeKey: beforeNode.key,
+          afterKey: afterNode.key,
+        };
+      }
+
+      return {
+        beforeSubject: afterNode.prev?.subjectId,
+        afterSubject: afterNode.subjectId,
+        beforeKey: afterNode.prev?.key,
+        afterKey: afterNode.key,
+      };
+    }
