{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "outDir": "../../dist/apps/studio-devtools/dist",
    "declarationDir": "../../dist/apps/studio-devtools/dist",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "module": "ESNext",
    "types": [
      "node"
    ],
    "paths": {}
  },
  "exclude": [
    "src/**/*.spec.ts",
    "vitest.config.ts",
    "devtools/**",
    "panel/**",
    "content/**",
    "smoke/**"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
