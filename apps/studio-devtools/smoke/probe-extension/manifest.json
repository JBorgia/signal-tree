{
  "manifest_version": 3,
  "name": "SignalTree Studio full-chain probe",
  "version": "0.1.0",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8791/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8791/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "driver.html"
      ],
      "matches": [
        "http://localhost:8791/*"
      ]
    }
  ],
  "background": {
    "service_worker": "sw.js"
  }
}
