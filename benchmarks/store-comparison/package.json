{
  "name": "signaltree-store-comparison",
  "private": true,
  "type": "module",
  "description": "Browser + Angular comparison of state libraries on one grid/editor workload. Standalone: every arm resolves from installed packages, never from workspace source.",
  "scripts": {
    "install-candidate": "node scripts/install-candidate.mjs",
    "build": "ng build --configuration production --stats-json",
    "bench": "node scripts/run.mjs"
  },
  "dependencies": {
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/platform-browser": "22.0.7",
    "@angular/router": "22.0.7",
    "@ngrx/signals": "22.0.1",
    "@signaltree/core": "14.1.3",
    "st15-released": "npm:@signal-tree/angular@15.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "playwright": "1.58.2",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
