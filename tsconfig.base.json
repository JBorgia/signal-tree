{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2015", "dom", "es2021"],
    "downlevelIteration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "types": ["@angular/core", "vitest/globals"],
    "paths": {
      "@signal-tree/angular": [
        "packages/angular/src/index.ts"
      ],
      "@signal-tree/kernel/adapter": [
        "packages/kernel/src/adapter.ts"
      ],
      "@signal-tree/kernel": ["packages/kernel/src/index.ts"],
      "@signaltree/events": ["packages/events/src/index.ts"],
      "@signaltree/events/*": ["packages/events/src/*"],
      "@signaltree/ng-forms": ["packages/ng-forms/src/index.ts"],
      "@signaltree/ng-forms/signals": [
        "packages/ng-forms/src/signals/index.ts"
      ],
      "@signaltree/shared": ["packages/shared/src/index.ts"],
      "@signaltree/shared/*": ["packages/shared/src/*"]
    },
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["types.d.ts"],
  "exclude": ["node_modules", "tmp"]
}
