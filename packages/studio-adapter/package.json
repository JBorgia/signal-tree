{
  "name": "@signal-tree/studio-adapter",
  "version": "15.0.0",
  "description": "Opt-in bridge from the SignalTree kernel observation seam to Studio.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./bridge": {
      "types": "./src/bridge/index.d.ts",
      "import": "./dist/bridge/index.js",
      "default": "./dist/bridge/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "llms.txt"
  ],
  "dependencies": {
    "@signal-tree/studio-query": "workspace:*",
    "@signal-tree/kernel": "workspace:*"
  },
  "peerDependencies": {
    "tslib": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBorgia/signal-tree.git",
    "directory": "packages/studio-adapter"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
