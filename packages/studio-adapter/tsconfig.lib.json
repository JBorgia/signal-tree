{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "outDir": "../../dist/packages/studio-adapter/dist",
    "declarationDir": "../../dist/packages/studio-adapter/dist",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "module": "ESNext",
    "types": ["node"],
    "paths": {
      "@signal-tree/studio-query": [
        "dist/packages/studio-query/src/index.d.ts"
      ],
      "@signal-tree/kernel": ["dist/packages/kernel/dist/index.d.ts"],
      "@signal-tree/kernel/adapter": ["dist/packages/kernel/dist/adapter.d.ts"],
      "@signal-tree/kernel/internals": [
        "dist/packages/kernel/dist/internals.d.ts"
      ]
    }
  },
  "exclude": ["src/**/*.spec.ts", "vitest.config.ts"],
  "include": ["src/**/*.ts"]
}
