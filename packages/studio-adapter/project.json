{
  "name": "studio-adapter",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/studio-adapter/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "implicitDependencies": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p packages/studio-adapter/tsconfig.spec.json && npx vitest run --config packages/studio-adapter/vitest.config.ts",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
