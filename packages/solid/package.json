    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "llms.txt"
  ],
  "dependencies": {
    "@signal-tree/kernel": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "tslib": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBorgia/signal-tree.git",
    "directory": "packages/solid"
  }
