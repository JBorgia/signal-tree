{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "outDir": "../../dist/packages/kernel/dist",
    "declarationDir": "../../dist/packages/kernel/dist",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "module": "ESNext",
    "types": ["node"]
  },
  "exclude": [
    "src/**/*.spec.ts",
    "vitest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.d.ts",
    "src/lib/experimental/**",
    "src/reactive-test-realization.ts"
  ],
  "include": ["src/**/*.ts"]
}
