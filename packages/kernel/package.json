{
  "name": "@signal-tree/kernel",
  "version": "15.0.0-rc.12",
  "description": "SignalTree: framework-neutral reactive application state with causal semantics.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    }
  },
  "peerDependencies": {
    "tslib": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "llms.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBorgia/signal-tree.git",
    "directory": "packages/kernel"
  },
  "bugs": {
    "url": "https://github.com/JBorgia/signal-tree/issues"
  },
  "homepage": "https://github.com/JBorgia/signal-tree/tree/main/packages/kernel#readme"
}
