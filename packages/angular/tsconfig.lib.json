{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "outDir": "../../dist/packages/angular/dist",
    "declarationDir": "../../dist/packages/angular/dist",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "module": "ESNext",
    "types": [
      "node"
    ],
    "paths": {
      "@signal-tree/kernel": [
        "packages/kernel/src/index.ts"
      ],
      "@signal-tree/kernel/adapter": [
        "packages/kernel/src/adapter.ts"
      ]
    }
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "vitest.config.ts"
  ],
  "include": [
    "src/**/*.ts"
  ]
}