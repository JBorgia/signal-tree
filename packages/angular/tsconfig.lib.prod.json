{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "declarationMap": false,
    "declaration": true,
    "stripInternal": true,
    "sourceMap": false,
    "outDir": "../../dist/packages/angular/dist",
    "declarationDir": "../../dist/packages/angular/dist"
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
