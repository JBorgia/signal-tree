{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/core/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/core/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/core/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/core/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "pack-and-build-others": {
      "executor": "@nx/workspace:run-commands",
      "options": {
        "commands": [
          "npx ng-packagr -p packages/core/ng-package.json",
          "rm -rf node_modules/@signaltree/core || true",
          "mkdir -p node_modules/@signaltree",
          "cp -R dist/packages/core node_modules/@signaltree/core",
          "npx ng-packagr -p packages/batching/ng-package.json",
          "npx ng-packagr -p packages/devtools/ng-package.json",
          "npx ng-packagr -p packages/middleware/ng-package.json",
          "node scripts/bundle-size-report.js",
          "rm -rf node_modules/@signaltree/core"
        ],
        "parallel": false
      }
    },
    "build:esm": {
      "executor": "@nx/workspace:run-commands",
      "options": {
        "commands": ["npx tsc -p packages/core/tsconfig.build.json"],
        "parallel": false
      }
    },
    "pack-esm": {
      "executor": "@nx/workspace:run-commands",
      "options": {
        "commands": [
          "npx tsc -p packages/core/tsconfig.build.json",
          "rm -rf packages/core/dist/esm/package.json || true",
          "cp packages/core/package.json packages/core/dist/esm/package.json",
          "cd packages/core/dist/esm && npm pack"
        ],
        "cwd": ".",
        "parallel": false
      }
    }
  }
}
