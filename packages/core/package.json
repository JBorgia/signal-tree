{
  "name": "@signaltree/core",
  "version": "15.0.0-rc.1",
  "description": "Reactive JSON for Angular. State as shape. Signals at every path.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "tslib": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBorgia/signaltree.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/JBorgia/signaltree/issues"
  },
  "homepage": "https://github.com/JBorgia/signaltree/tree/main/packages/core#readme"
}
