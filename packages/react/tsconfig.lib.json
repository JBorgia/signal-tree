{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "outDir": "../../dist/packages/react/dist",
    "declarationDir": "../../dist/packages/react/dist",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "module": "ESNext",
    "types": [
      "node",
      "react"
    ],
    "paths": {
      "@signal-tree/kernel": [
        "dist/packages/kernel/dist/index.d.ts"
      ],
      "@signal-tree/kernel/adapter": [
        "dist/packages/kernel/dist/adapter.d.ts"
      ]
    }
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.typing.spec.ts",
    "vitest.config.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
