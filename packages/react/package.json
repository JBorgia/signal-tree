{
  "name": "@signal-tree/react",
  "version": "15.0.0-rc.13",
  "description": "React observation for SignalTree.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "llms.txt"
  ],
  "dependencies": {
    "@signal-tree/kernel": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "tslib": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBorgia/signal-tree.git",
    "directory": "packages/react"
  }
}
