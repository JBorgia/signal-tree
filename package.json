{
  "name": "signal-tree-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBorgia/signal-tree.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint packages ci tests bench && node ci/boundaries.mjs",
    "scan:core-bundle": "node ci/core-bundle-scan.mjs",
    "manifest:check": "node ci/port-manifest.mjs check",
    "oracle": "pnpm --filter @signal-tree/oracle oracle",
    "bench": "pnpm --filter @signal-tree/bench bench",
    "bench:test": "pnpm --filter @signal-tree/bench test"
  },
  "devDependencies": {
    "@signal-tree/core": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
