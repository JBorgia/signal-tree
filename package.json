{
  "name": "@signaltree/workspace",
  "version": "15.0.0-rc.12",
  "packageManager": "pnpm@10.17.0",
  "license": "Apache-2.0",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/JBorgia"
  },
  "author": "Jonathan D Borgia",
  "homepage": "https://github.com/JBorgia/signal-tree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBorgia/signal-tree.git"
  },
  "bugs": {
    "url": "https://github.com/JBorgia/signal-tree/issues"
  },
  "scripts": {
    "build": "nx run-many -t build --projects=kernel,angular,react",
    "test": "nx test",
    "lint": "nx run-many -t lint",
    "serve": "nx serve",
    "e2e": "nx e2e",
    "start": "nx serve demo",
    "build:lib": "nx run-many -t build --projects=kernel,angular,react --configuration=production",
    "build:demo": "nx build demo",
    "deploy": "npm run build:demo:prod && npm run deploy:gh-pages",
    "build:demo:prod": "nx build demo --configuration=production --base-href=/",
    "deploy:gh-pages": "gh-pages -d dist/apps/demo/browser",
    "test:lib": "nx run-many -t test --projects=kernel,angular,react",
    "test:demo": "nx test demo",
    "test:watch": "nx test --watch",
    "test:ci": "nx test --watch=false --browsers=ChromeHeadless",
    "lint:fix": "nx run-many -t lint --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "docs": "typedoc",
    "docs:serve": "typedoc --serve",
    "affected:build": "nx affected:build",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:e2e": "nx affected:e2e",
    "affected": "nx affected",
    "graph": "nx graph",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "publish": "node scripts/publish-candidate.mjs",
    "publish:dry-run": "node scripts/publish-candidate.mjs --dry-run",
    "release": "./scripts/release.sh patch",
    "release:rc": "./scripts/release.sh rc",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "release:patch": "./scripts/release.sh patch",
    "// Enhanced Build Scripts": "Scripts for efficient development and production builds",
    "build:all": "nx run-many -t build --projects=kernel,angular,react",
    "build:core": "nx build kernel",
    "build:packages": "nx run-many -t build --projects=kernel,angular,react",
    "build:production": "nx run-many -t build --configuration=production --projects=kernel,angular,react",
    "// Testing Scripts": "Comprehensive testing workflows",
    "test:all": "nx run-many -t test --projects=kernel,angular,react,demo,react-reference --parallel=1",
    "test:core": "nx test kernel",
    "test:performance": "nx test kernel --testNamePattern=\"performance\"",
    "test:recursive": "nx test kernel --testNamePattern=\"recursive\"",
    "test:coverage": "nx test kernel --codeCoverage",
    "// Linting & Quality": "Code quality and formatting",
    "lint:all": "nx run-many -t lint --projects=kernel,angular,react,demo",
    "lint:core": "nx lint kernel",
    "lint:fix:all": "nx run-many -t lint --fix --projects=kernel,angular,react,demo",
    "typecheck": "tsc --noEmit -p packages/kernel/tsconfig.typecheck.json && tsc --noEmit -p tsconfig.typecheck-all.json",
    "quality:check": "npm run lint:all && npm run typecheck && npm run test:all && npm run build:all",
    "quality:simple": "npm run test:core && npm run build:core",
    "quality:fix": "npm run lint:fix:all && npm run test:all",
    "// Development Workflow": "Complete development workflows",
    "prepare:versions": "node tools/generate-version-env.cjs",
    "dev": "nx serve demo",
    "dev:build": "npm run build:core && nx serve demo",
    "dev:check": "npm run test:core && npm run lint:core",
    "clean": "nx reset && rm -rf dist node_modules/.cache",
    "clean:build": "npm run clean && pnpm install && npm run build:all",
    "// Publishing & Release": "Streamlined publishing workflows",
    "prepublish": "node scripts/ci-checks.js --jsdoc --sizes && node tools/check-declaration-docs.mjs && npm run quality:check && npm run build:production",
    "publish:packages": "npm run prepublish && nx run-many -t build --configuration=production",
    "publish:all": "node scripts/publish-candidate.mjs",
    "publish:ci": "bash scripts/ci-publish.sh",
    "deprecate:packages": "./scripts/deprecate-packages.sh",
    "deprecate:dry-run": "./scripts/deprecate-packages.sh --dry-run",
    "// Validation & Quality Gates": "Pre-release validation and quality checks",
    "validate": "bash scripts/pre-publish-validation.sh",
    "validate:dist": "bash scripts/verify-dist.sh",
    "validate:production-bundle": "node scripts/verify-production-bundle-no-perf-instrumentation.mjs",
    "validate:exports": "node scripts/verify-exports.js",
    "validate:docs": "bash scripts/validate-docs.sh",
    "validate:version-claims": "node scripts/verify-version-claims.js",
    "validate:release-state": "node scripts/verify-release-state.js",
    "validate:rc-surface": "node tools/check-rc-public-dispositions.mjs",
    "validate:tarball-consumer": "node tools/verify-tarball-consumer.mjs",
    "validate:changelog-entry": "bash scripts/verify-changelog-entry.sh",
    "validate:types": "bash scripts/verify-no-broken-dts.sh",
    "validate:budget": "node tools/check-bundle-budget.mjs",
    "validate:tree-shaking": "node scripts/verify-tree-shaking.js",
    "validate:clean-release": "bash scripts/verify-clean-checkout-release-flow.sh",
    "validate:all": "npm run validate",
    "// Performance & Analysis": "Performance testing and bundle analysis",
    "perf:test": "npm run test:performance",
    "perf:build": "npm run build:production && npm run analyze:bundle",
    "perf:run": "node scripts/perf-suite.js",
    "test:history-spike": "pnpm exec vitest run packages/kernel/src/lib/path-notifier.spec.ts packages/kernel/src/lib/internals/intercept-leaf-signals.spec.ts packages/kernel/src/lib/markers/form.spec.ts packages/kernel/src/lib/entity-active-prepend-changeid.spec.ts packages/kernel/src/enhancers/time-travel/time-travel.spec.ts packages/kernel/src/enhancers/time-travel/documented-defects.spec.ts packages/kernel/src/enhancers/time-travel/leaf-write-history.spec.ts packages/kernel/src/lib/undo-redo.spec.ts packages/kernel/src/lib/rollback-viability-prototype.spec.ts packages/kernel/src/lib/position-identity-prototype.spec.ts",
    "bench:history-spike": "npm run bench:history-ownership",
    "bench:history-spike:smoke": "npm run bench:history-ownership:smoke",
    "bench:positionid-substrate": "node tools/bench-positionid-substrate.mjs",
    "bench:positionid-substrate:smoke": "node tools/bench-positionid-substrate.mjs --smoke",
    "validate:history-spike": "npm run test:history-spike && npm run bench:history-spike:smoke && node tools/verify-gates.mjs --self-test --only=history-ownership-bench",
    "bench:history-ownership": "node --expose-gc tools/bench-history-ownership.mjs",
    "bench:history-ownership:smoke": "node --expose-gc tools/bench-history-ownership.mjs --smoke",
    "smoke:routes": "playwright test --config=scripts/playwright/route-smoke.config.ts",
    "audit:mobile": "playwright test --config=scripts/playwright/route-smoke.config.ts mobile-layout.spec.ts",
    "audit:visual": "playwright test --config=scripts/playwright/route-smoke.config.ts visual-language.spec.ts",
    "automation:export": "node --loader ts-node/esm scripts/playwright/run-benchmark-export.ts",
    "automation:export:cjs": "node scripts/playwright/run-benchmark-export.cjs",
    "automation:export:all": "node scripts/playwright/run-benchmark-export-all.cjs",
    "architecture:assets": "node tools/generate-architecture-diagrams.mjs",
    "architecture:assets:check": "node tools/generate-architecture-diagrams.mjs --check",
    "analyze:bundle": "node scripts/consolidated-bundle-analysis.js",
    "analyze:deps": "nx graph",
    "size:report": "node scripts/consolidated-bundle-analysis.js",
    "size:check": "node tools/check-bundle-budget.mjs",
    "verify:jsdoc": "node scripts/verify-jsdoc-stripping.js",
    "postbuild": "npm run verify:jsdoc && node tools/check-declaration-docs.mjs",
    "size:validate": "node tools/check-bundle-budget.mjs",
    "// Callable Syntax": "Callable syntax transformation tooling and testing",
    "// Maintenance": "Workspace maintenance and updates",
    "update:deps": "nx migrate latest && npm install && nx migrate --run-migrations",
    "workspace:info": "nx report",
    "check:devmode-foldable": "node tools/check-devmode-foldable.mjs",
    "typecheck:typing": "tsc --noEmit -p packages/kernel/tsconfig.typecheck.json",
    "typecheck:source": "tsc --noEmit -p tsconfig.typecheck-all.json",
    "gates": "node tools/verify-gates.mjs",
    "gates:fast": "node tools/verify-gates.mjs --fast",
    "gates:self-test": "node tools/verify-gates.mjs --self-test",
    "gates:list": "node tools/verify-gates.mjs --list",
    "lint:budget": "node tools/check-lint-budget.mjs",
    "dead-exports": "node tools/find-dead-exports.mjs",
    "prepare:publish-artifacts": "node scripts/prepare-publish-artifacts.mjs",
    "lint:readmes": "node scripts/lint-readme-apis.mjs"
  },
  "private": true,
